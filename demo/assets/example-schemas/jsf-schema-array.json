{
  "schema": {
    "friends": {
      "type": "array",
      "items": {
        "type": "object",
        "title": "Friend",
        "required": [
          "nick"
        ],
        "properties": {
          "nick": {
            "type": "string",
            "title": "Nickname"
          },
          "gender": {
            "type": "string",
            "title": "Gender",
            "enum": [
              "male",
              "female",
              "alien"
            ]
          },
          "age": {
            "type": "integer",
            "title": "Age"
          }
        }
      }
    }
  }
}
